<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows MIDI Services SDK package is published on GitHub (microsoft/MIDI release rc-3), not on nuget.org.
     Download Microsoft.Windows.Devices.Midi2.1.0.16-rc.3.7.nupkg from there into ./packages. -->
<configuration>
  <packageSources>
    <add key="midi-sdk-local" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
